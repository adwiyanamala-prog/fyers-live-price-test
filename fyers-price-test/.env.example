# FYERS API V3 Credentials
# Replace with your actual App ID (Client ID) and Access Token
# Client ID usually looks like: XC12345-100 (where XC12345 is your Fyers User ID and 100 is App ID)
FYERS_CLIENT_ID=your_client_id_here

# Access token obtained after authenticating with FYERS API v3
FYERS_ACCESS_TOKEN=your_access_token_here

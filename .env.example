# FYERS Live Price Test - Environment Configuration
# Copy this file to .env and fill in your credentials

# FYERS API Credentials (Market Data / Price Fetch)
FYERS_CLIENT_ID=your_client_id_here
FYERS_SECRET_KEY=your_secret_key_here
FYERS_ACCESS_TOKEN=your_access_token_here

# FYERS Trading App Credentials (Optional: if separate from market data app)
FYERS_TRADE_CLIENT_ID=your_trade_client_id_here
FYERS_TRADE_SECRET_KEY=your_trade_secret_key_here
FYERS_TRADE_ACCESS_TOKEN=your_trade_access_token_here

# Telegram Integration Credentials
# Create a bot via @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN=
# Get your numeric User/Chat ID via @userinfobot on Telegram (comma-separate for multiple IDs)
TELEGRAM_CHAT_ID=
# Notification preferences: true or false
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_SMART_MONEY_ALERTS=true
TELEGRAM_ORDER_ALERTS=true
# Default trading mode for Telegram commands: paper or live
TELEGRAM_DEFAULT_MODE=paper

# Set to false for real FYERS WebSocket connection
MOCK_MODE=false

# Server ports
PORT=3000
WORKER_PORT=3001
